# ======================
# Django Backend Settings
# ======================

# Generate a new secret key:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE-ME-GENERATE-A-REAL-SECRET-KEY

DJANGO_DEBUG=False

# Replace with your VM's external IP and sslip.io domain
# Example: if IP is 34.123.45.67, use: 34.123.45.67,34-123-45-67.sslip.io
DJANGO_ALLOWED_HOSTS=YOUR_VM_IP,YOUR_VM_IP.sslip.io

# ======================
# CORS Settings
# ======================

# Use your sslip.io domain (with https://)
# Example: https://34-123-45-67.sslip.io
DJANGO_CORS_ALLOWED_ORIGINS=https://YOUR_VM_IP_DASHES.sslip.io
DJANGO_CORS_ALLOW_CREDENTIALS=True

# ======================
# CSRF Settings
# ======================

DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_VM_IP_DASHES.sslip.io

# ======================
# Database Settings
# ======================

POSTGRES_DB=udnnews_db
POSTGRES_USER=udnnews_user
POSTGRES_PASSWORD=CHANGE-ME-USE-A-STRONG-PASSWORD
DJANGO_DATABASE_URL=postgresql://udnnews_user:CHANGE-ME-USE-A-STRONG-PASSWORD@db:5432/udnnews_db

# ======================
# Security Settings (Production - HTTPS enabled)
# ======================

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ======================
# Celery / Redis Settings
# ======================
CELERY_BROKER_URL=redis://redis:6379/0
